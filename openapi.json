  },
  "components": {
    "parameters": {
      "UserId": {
        "name": "id",
        "in": "path",
        "required": true,
        "description": "Unique identifier of the user (9-character alphanumeric)",
        "schema": {
          "type": "string",
          "pattern": "^[a-z0-9]{9}$",
          "example": "a9df96594"
        }
      },
      "ProductId": {
        "name": "id",
        "in": "path",
        "required": true,
        "description": "Unique identifier of the product (9-character alphanumeric)",
        "schema": {
          "type": "string",
          "pattern": "^[a-z0-9]{9}$",
          "example": "b8ce85483"
        }
      },
      "OrderId": {
        "name": "id",
        "in": "path",
        "required": true,
        "description": "Unique identifier of the order (9-character alphanumeric)",
        "schema": {
          "type": "string",
          "pattern": "^[a-z0-9]{9}$",
          "example": "c7bd74372"
        }
      }
    },
    "schemas": {
      "User": {
        "type": "object",
        "required": [
          "id",
          "name",
          "email",
          "createdAt",
          "updatedAt"
        ],
        "properties": {
          "id": {
            "type": "string",
            "description": "Unique identifier for the user (9-character alphanumeric)",
            "pattern": "^[a-z0-9]{9}$",
            "example": "a9df96594"
          },
          "name": {
            "type": "string",
            "description": "Full name of the user",
            "minLength": 1,
            "maxLength": 100,
            "example": "John Doe"
          },
          "email": {
            "type": "string",
            "format": "email",
            "description": "Email address of the user",
            "example": "john.doe@example.com"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time",
            "description": "Timestamp when the user was created",
            "example": "2025-10-20T10:30:00.000Z"
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time",
            "description": "Timestamp when the user was last updated",
            "example": "2025-10-20T10:30:00.000Z"
          }
        }
      },
      "CreateUserRequest": {
        "type": "object",
        "required": [
          "name",
          "email"
        ],
        "properties": {
          "name": {
            "type": "string",
            "description": "Full name of the user",
            "minLength": 1,
            "maxLength": 100,
            "example": "John Doe"
          },
          "email": {
            "type": "string",
            "format": "email",
            "description": "Email address of the user",
            "example": "john.doe@example.com"
          }
        }
      },
      "UpdateUserRequest": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "description": "Full name of the user",
            "minLength": 1,
            "maxLength": 100,
            "example": "John Updated"
          },
          "email": {
            "type": "string",
            "format": "email",
            "description": "Email address of the user",
            "example": "john.updated@example.com"
          }
        },
        "minProperties": 1
      },
      "Product": {
        "type": "object",
        "required": [
          "id",
          "name",
          "description",
          "price",
          "category",
